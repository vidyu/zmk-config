#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <behaviors/num_word.dtsi>

#ifndef KEYMAP_DRAWER
#include "keys_de.h"
#include "macros.h"
#endif

#include "key-labels.h"
#include "mouse.dtsi"

#define KEYS_L LT0 LT1 LT2 LT3 LT4 LM0 LM1 LM2 LM3 LM4 LB0 LB1 LB2 LB3 LB4
#define KEYS_R RT0 RT1 RT2 RT3 RT4 RM0 RM1 RM2 RM3 RM4 RM5 RB0 RB1 RB2 RB3 RB4 RB5

#define THUMBS LH2 LH1 LH0 RH0 RH1 RH2

&caps_word {
    continue-list = <DE_MINUS LS(DE_MINUS) BSPC>;
};

&num_word {
  continue-list = <LEFT RIGHT UP DOWN BSPC DEL DE_DOT DE_COMMA DE_PLUS DE_MINUS DE_ASTRK DE_FSLH DE_EQUAL>;
};

/ {
    chosen {
        zmk,physical-layout = &default_layout;
    };
};

/ {
  behaviors {
    nav_word: nav_word {
      compatible = "zmk,behavior-auto-layer";
      #binding-cells = <1>;
      continue-list = <MOVE_LEFT MOVE_DOWN MOVE_UP MOVE_RIGHT SCRL_LEFT SCRL_DOWN SCRL_UP SCRL_RIGHT LCLK RCLK>;
      ignore-modifiers;
    };
  };
};

/ {
    beaviors {
        hml: HomeRowModLeft {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = < KEYS_R THUMBS >; // List of keys on the right side of the keyboard
            hold-trigger-on-release;
        };
        hmr: HomeRowModRight {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = < KEYS_L THUMBS >; // List of keys on the left side of the keyboard
            hold-trigger-on-release;
        };
        cwl: CapsWordLayer {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&nav_word>, <&caps_word>;
        };
        nwsk: NavkwordSticky {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&nav_word>, <&sk>;
        };
        nwl: NumWorkdLayer {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&num_word>, <&kp>;
        };
    };
};


/ {
  beaviors {
    sq: SlashQuestion {
      compatible = "zmk,behavior-mod-morph";
      #binding-cells = <0>;
      bindings = <&kp DE_SLASH>, <&kp DE_QMARK>;
      mods = <(MOD_LSFT|MOD_RSFT)>;
    };
    bsl: BackslashPipe {
      compatible = "zmk,behavior-mod-morph";
      #binding-cells = <0>;
      bindings = <&kp DE_BSLH>, <&kp DE_PIPE>;
      mods = <(MOD_LSFT|MOD_RSFT)>;
    };
    quotes: SingleAndDouble {
      compatible = "zmk,behavior-mod-morph";
      #binding-cells = <0>;
      bindings = <&kp DE_APOS>, <&kp DE_DOUBLE_QUOTES>;
      mods = <(MOD_LSFT|MOD_RSFT)>;
    };
    pltild: PlusAndTilde {
      compatible = "zmk,behavior-mod-morph";
      #binding-cells = <0>;
      bindings = <&hmr RALT DE_PLUS>, <&kp DE_TILDE>;
      mods = <(MOD_LSFT|MOD_RSFT)>;
    };
    bspcgrave: BackspaceAndGrave {
      compatible = "zmk,behavior-mod-morph";
      #binding-cells = <0>;
      bindings = <&kp BSPC>, <&kp DE_GRAVE>;
      mods = <(MOD_LSFT|MOD_RSFT)>;
    };
    td_layer_astrk: TapDanceLayerAstrk {
      compatible = "zmk,behavior-tap-dance";
      #binding-cells = <0>;
      tapping-term-ms = <200>;
      bindings = <&lt 1 DE_ASTRK>, <&lt 2 DE_ASTRK>;
    };
    td_num_hash: TapDanceNumHash {
      compatible = "zmk,behavior-tap-dance";
      #binding-cells = <0>;
      tapping-term-ms = <200>;
      bindings = <&kp DE_HASH>,  <&num_word 1>;
    };
    td_layer_ralt: TapDanceLayerHash {
      compatible = "zmk,behavior-tap-dance";
      #binding-cells = <0>;
      tapping-term-ms = <200>;
      bindings = <&mo 2>, <&kp RALT>;
    };
    td_quotes: TapDAnceQuotes {
      compatible = "zmk,behavior-tap-dance";
      #binding-cells = <0>;
      tapping-term-ms = <200>;
      bindings = <&quotes>, <&kp DE_DOUBLE_QUOTES>, <&kp DE_GRAVE>;
    };
  };
};

/ {
    combos {
        compatible = "zmk,combos";
        combo_l_bkt {
            timeout-ms = <50>;
            key-positions = <RM1 RM2>;
            bindings = <&kp DE_LBKT>;
            require-prior-idle-ms = <150>;
            layers = <0>;
        };
        combo_r_bkt {
            timeout-ms = <50>;
            key-positions = <RM2 RM3>;
            bindings = <&kp DE_RBKT>;
            require-prior-idle-ms = <150>;
            layers = <0>;
        };
        combo_l_par {
            timeout-ms = <50>;
            key-positions = <RT1 RT2>;
            bindings = <&kp DE_LPAR>;
            require-prior-idle-ms = <150>;
            layers = <0>;
        };
        combo_r_par {
            timeout-ms = <50>;
            key-positions = <RT2 RT3>;
            bindings = <&kp DE_RPAR>;
            require-prior-idle-ms = <150>;
            layers = <0>;
        };
        combo_l_brc {
            timeout-ms = <50>;
            key-positions = <RB1 RB2>;
            bindings = <&kp DE_LBRC>;
            require-prior-idle-ms = <150>;
            layers = <0>;
        };
        combo_r_brc {
            timeout-ms = <50>;
            key-positions = <RB2 RB3>;
            bindings = <&kp DE_RBRC>;
            require-prior-idle-ms = <150>;
            layers = <0>;
        };
        combo_lt {
            timeout-ms = <50>;
            key-positions = <RM0 RM1>;
            bindings = <&kp DE_LT>;
            require-prior-idle-ms = <150>;
            layers = <0>;
        };
        combo_gt {
            timeout-ms = <50>;
            key-positions = <RM3 RM4>;
            bindings = <&kp DE_GT>;
            require-prior-idle-ms = <150>;
            layers = <0>;
        };
        combo_caret {
            timeout-ms = <50>;
            key-positions = <RB3 RB4>;
            bindings = <&kp DE_CARET>;
            require-prior-idle-ms = <150>;
            layers = <0>;
        };
        combo_eql {
            timeout-ms = <50>;
            key-positions = <RT1 RT3>;
            bindings = <&kp DE_EQUAL>;
            require-prior-idle-ms = <150>;
            layers = <0>;
        };
        /* combo_astrk { */
        /*     timeout-ms = <50>; */
        /*     key-positions = <RB1 RB3>; */
        /*     bindings = <&kp DE_ASTRK>; */
        /*     require-prior-idle-ms = <150>; */
        /*     layers = <0>; */
        /* }; */
        combo_amps {
            timeout-ms = <50>;
            key-positions = <RT0 RT1>;
            bindings = <&kp DE_AMPS>;
            require-prior-idle-ms = <150>;
            layers = <0>;
        };
        combo_dllr {
            timeout-ms = <50>;
            key-positions = <RB0 RB1>;
            bindings = <&kp DE_DLLR>;
            require-prior-idle-ms = <150>;
            layers = <0>;
        };
        combo_quote {
            timeout-ms = <50>;
            key-positions = <RM2 RB2>;
            bindings = <&quotes>;
            require-prior-idle-ms = <150>;
            layers = <0>;
        };
        combo_colon {
            timeout-ms = <50>;
            key-positions = <RM1 RM3>;
            bindings = <&kp DE_COLON>;
            require-prior-idle-ms = <150>;
            layers = <0>;
        };
        combo_prcnt {
            timeout-ms = <50>;
            key-positions = <RB1 RB3>;
            bindings = <&kp DE_PRCNT>;
            require-prior-idle-ms = <150>;
            layers = <0>;
        };
        combo_excl {
            timeout-ms = <50>;
            key-positions = <RT2 RM2>;
            bindings = <&kp DE_EXCL>;
            require-prior-idle-ms = <150>;
            layers = <0>;
        };
        combo_at {
            timeout-ms = <50>;
            key-positions = <RT3 RT4>;
            bindings = <&kp DE_AT>;
            require-prior-idle-ms = <150>;
            layers = <0>;
        };
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTZ";
            bindings = <
                &kp TAB       &kp DE_Q       &kp DE_W        &kp DE_E        &kp DE_R       &kp DE_T     &kp C_MUTE   &kp EMOJI    &kp DE_Z &kp DE_U        &kp DE_I        &kp DE_O        &kp DE_P     &bspcgrave
                &mt HYPER ESC &hml LALT DE_A &hml LCTRL DE_S &hml LSHFT DE_D &hml LGUI DE_F &kp DE_G     &kp C_BRI_DN &kp C_BRI_UP &kp DE_H &hmr RGUI DE_J  &hmr RSHFT DE_K &hmr RCTRL DE_L &pltild      &bsl
                &td_quotes    &kp DE_Y       &kp DE_X        &kp DE_C        &kp DE_V       &kp DE_B                               &kp DE_N &kp DE_M        &kp DE_COMMA    &kp DE_DOT      &kp DE_MINUS &sq
                                                             &nwsk 2 RALT    &nwl 1 DE_HASH &kp SPACE                              &kp RET  &nwl 1 DE_ASTRK &cwl 2 0 
            >;
        };

        lower_layer {
            display-name = "NUMBER";
            bindings = <
                &trans &trans    &kp DE_N7 &kp DE_N8 &kp DE_N9 &trans &kp PASSWORD &rgb_ug RGB_TOG &trans   &trans   &trans &trans    &trans &trans
                &trans &kp DE_N0 &kp DE_N4 &kp DE_N5 &kp DE_N6 &trans &trans       &trans          &kp LEFT &kp DOWN &kp UP &kp RIGHT &trans &trans
                &trans &trans    &kp DE_N1 &kp DE_N2 &kp DE_N3 &trans                              &trans   &trans   &trans &trans    &trans &trans
                                           &trans    &trans    &trans                              &trans   &trans   &trans
            >;
        };

        raise_layer {
            display-name = "MOUSE";
            bindings = <
                &trans &trans &trans &trans &trans    &trans  &studio_unlock &trans   &msc SCRL_LEFT &msc SCRL_UP   &msc SCRL_DOWN &msc SCRL_RIGHT &trans &trans
                &trans &trans &trans &trans &mkp LCLK &trans  &bt BT_SEL 0   &trans   &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_UP   &mmv MOVE_RIGHT &trans &trans
                &trans &trans &trans &trans &mkp RCLK &trans                          &trans         &trans         &trans         &trans          &trans &trans 
                                     &trans &trans    &trans                          &trans         &trans         &trans
            >;
        };
    };
};

