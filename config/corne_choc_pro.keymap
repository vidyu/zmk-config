#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>

#ifndef KEYMAP_DRAWER
#include "keys_de.h"
#include "macros.h"
#endif

#include "key-labels.h"
#include "mouse.dtsi"

#define KEYS_L LT0 LT1 LT2 LT3 LT4 LM0 LM1 LM2 LM3 LM4 LB0 LB1 LB2 LB3 LB4
#define KEYS_R RT0 RT1 RT2 RT3 RT4 RM0 RM1 RM2 RM3 RM4 RM5 RB0 RB1 RB2 RB3 RB4 RB5

#define THUMBS LH2 LH1 LH0 RH0 RH1 RH2

/ {
    chosen {
        zmk,physical-layout = &default_layout;
    };
};

/ {
    behaviors {
        hml: HomeRowModLeft {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = < KEYS_R THUMBS >; // List of keys on the right side of the keyboard
            hold-trigger-on-release;
        };
        hmr: HomeRowModRight {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = < KEYS_L THUMBS >; // List of keys on the left side of the keyboard
            hold-trigger-on-release;
        };
        hmt: HomeRowModThumb {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            // No hold-trigger-key-positions on purpose: this thumb carries the
            // composing Alt, and macOS Option sequences live on both halves of
            // the board. A position list would cut off one of them.
        };
        // Enter only on a short, clean tap: any other key pressed while held
        // turns it into the layer, and there is no prior-idle shortcut, so
        // a mid-sentence number never fires a stray Return.
        lt_ent: EnterLayerThumb {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            bindings = <&mo>, <&kp>;
        };
        // Modifier on hold, /? morph on tap: &mt only takes a plain keycode.
        mt_sq: ModSlash {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&sq>;
        };
        // Modifier on hold, Bspc/Del morph on tap; tap-then-hold repeats Bspc.
        mt_bspc: ModBackspace {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&bspcdel>;
        };
    };
};


/ {
  behaviors {
    sq: SlashQuestion {
      compatible = "zmk,behavior-mod-morph";
      #binding-cells = <0>;
      bindings = <&kp DE_SLASH>, <&kp DE_QMARK>;
      mods = <(MOD_LSFT|MOD_RSFT)>;
    };
    bsl: BackslashPipe {
      compatible = "zmk,behavior-mod-morph";
      #binding-cells = <0>;
      bindings = <&kp DE_BSLH>, <&kp DE_PIPE>;
      mods = <(MOD_LSFT|MOD_RSFT)>;
    };
    // Hyper on the home-row pinkies. Opposite-hand trigger positions, like
    // hml/hmr, so same-hand rolls stay taps; the tap keeps the original morph.
    hy_a: HyperA {
      compatible = "zmk,behavior-hold-tap";
      #binding-cells = <2>;
      flavor = "balanced";
      require-prior-idle-ms = <150>;
      tapping-term-ms = <280>;
      quick-tap-ms = <175>;
      bindings = <&kp>, <&hm_a>;
      hold-trigger-key-positions = < KEYS_R THUMBS >;
      hold-trigger-on-release;
    };
    hy_plus: HyperPlus {
      compatible = "zmk,behavior-hold-tap";
      #binding-cells = <2>;
      flavor = "balanced";
      require-prior-idle-ms = <150>;
      tapping-term-ms = <280>;
      quick-tap-ms = <175>;
      bindings = <&kp>, <&pltild>;
      hold-trigger-key-positions = < KEYS_L THUMBS >;
      hold-trigger-on-release;
    };
    quotes: SingleAndDouble {
      compatible = "zmk,behavior-mod-morph";
      #binding-cells = <0>;
      bindings = <&quotes_alt>, <&kp DE_DOUBLE_QUOTES>;
      mods = <(MOD_LSFT|MOD_RSFT)>;
    };
    quotes_alt: SingleAndGraveLeft {
      compatible = "zmk,behavior-mod-morph";
      #binding-cells = <0>;
      bindings = <&quotes_ralt>, <&grave_lalt>;
      mods = <(MOD_LALT)>;
      keep-mods = <(MOD_LALT)>;
    };
    quotes_ralt: SingleAndGraveRight {
      compatible = "zmk,behavior-mod-morph";
      #binding-cells = <0>;
      bindings = <&kp DE_APOS>, <&grave_ralt>;
      mods = <(MOD_RALT)>;
      keep-mods = <(MOD_RALT)>;
    };
    pltild: PlusAndTilde {
      compatible = "zmk,behavior-mod-morph";
      #binding-cells = <0>;
      bindings = <&kp DE_PLUS>, <&kp DE_TILDE>;
      mods = <(MOD_LSFT|MOD_RSFT)>;
    };
    astrk_hash: AsteriskHash {
      compatible = "zmk,behavior-mod-morph";
      #binding-cells = <0>;
      bindings = <&kp DE_ASTRK>, <&kp DE_HASH>;
      mods = <(MOD_LSFT|MOD_RSFT)>;
    };
    bspcdel: BackspaceAndDelete {
      compatible = "zmk,behavior-mod-morph";
      #binding-cells = <0>;
      bindings = <&kp BSPC>, <&kp DEL>;
      mods = <(MOD_LSFT|MOD_RSFT)>;
    };
    // LALT, not RALT: two roles ride on this modifier and both need LEFT alt.
    //
    // 1. Umlauts. The morphs below fire in firmware and mask the modifier away,
    //    so macOS never sees an Option - `ü` is plain LEFT_BRACKET on a German
    //    layout. The modifier is a pure ZMK trigger here.
    // 2. Shortcuts. Ghostty runs `macos-option-as-alt = left`, so only LEFT
    //    option reaches the terminal as Alt. RALT stays a character modifier
    //    there and turns Option+P into `π` instead of firing the binding.
    //
    // Because no morph listens on P, the same held LALT that makes umlauts also
    // delivers Option+P untouched. Hyper therefore had to give up LALT and now
    // builds on RALT (see macros.h) - otherwise every Hyper chord would morph.
    //
    // Reach: the middle fingers (hml LALT on D, hmr LALT on K) serve the
    // umlauts; use the opposite hand's middle finger for instant cross-hand holds.
    hm_a: HomeRowAUmlaut {
      compatible = "zmk,behavior-mod-morph";
      #binding-cells = <0>;
      bindings = <&kp DE_A>, <&kp DE_A_UMLAUT>;
      mods = <(MOD_LALT)>;
    };
    hm_s: HomeRowEszett {
      compatible = "zmk,behavior-mod-morph";
      #binding-cells = <0>;
      bindings = <&hml LCTRL DE_S>, <&kp DE_ESZETT>;
      mods = <(MOD_LALT)>;
    };
    u_umlaut: UUmlaut {
      compatible = "zmk,behavior-mod-morph";
      #binding-cells = <0>;
      bindings = <&kp DE_U>, <&kp DE_U_UMLAUT>;
      mods = <(MOD_LALT)>;
    };
    o_umlaut: OUmlaut {
      compatible = "zmk,behavior-mod-morph";
      #binding-cells = <0>;
      bindings = <&kp DE_O>, <&kp DE_O_UMLAUT>;
      mods = <(MOD_LALT)>;
    };
    lbkt_par: LeftBracketdParen {
      compatible = "zmk,behavior-mod-morph";
      #binding-cells = <0>;
      bindings = <&kp DE_LBKT>, <&kp DE_LPAR>;
      mods = <(MOD_LSFT|MOD_RSFT)>;
    };
    rbkt_par: RightBracketdParen {
      compatible = "zmk,behavior-mod-morph";
      #binding-cells = <0>;
      bindings = <&kp DE_RBKT>, <&kp DE_RPAR>;
      mods = <(MOD_LSFT|MOD_RSFT)>;
    };
    lbrc_lt: LeftBraceLessThan {
      compatible = "zmk,behavior-mod-morph";
      #binding-cells = <0>;
      bindings = <&kp DE_LBRC>, <&kp DE_LT>;
      mods = <(MOD_LSFT|MOD_RSFT)>;
    };
    rbrc_gt: RightBraceGreaterThan {
      compatible = "zmk,behavior-mod-morph";
      #binding-cells = <0>;
      bindings = <&kp DE_RBRC>, <&kp DE_GT>;
      mods = <(MOD_LSFT|MOD_RSFT)>;
    };
    td_layer_astrk: TapDanceLayerAstrk {
      compatible = "zmk,behavior-tap-dance";
      #binding-cells = <0>;
      tapping-term-ms = <200>;
      bindings = <&lt 1 DE_ASTRK>, <&lt 2 DE_ASTRK>;
    };
    td_layer_ralt: TapDanceLayerHash {
      compatible = "zmk,behavior-tap-dance";
      #binding-cells = <0>;
      tapping-term-ms = <200>;
      bindings = <&mo 2>, <&kp RALT>;
    };
  };
};

/ {
  macros {
    grave_lalt: grave_macro_lalt {
      compatible = "zmk,behavior-macro";
      #binding-cells = <0>;
      wait-ms = <10>;
      tap-ms = <10>;
      bindings
        = <&macro_release &kp LALT>
        , <&macro_tap &kp DE_GRAVE &kp SPACE>
        , <&macro_press &kp LALT>;
    };
    grave_ralt: grave_macro_ralt {
      compatible = "zmk,behavior-macro";
      #binding-cells = <0>;
      wait-ms = <10>;
      tap-ms = <10>;
      bindings
        = <&macro_release &kp RALT>
        , <&macro_tap &kp DE_GRAVE &kp SPACE>
        , <&macro_press &kp RALT>;
    };
  };
};

/ {
    combos {
        compatible = "zmk,combos";
        combo_astrk {
            timeout-ms = <50>;
            key-positions = <RM1 RM4>;
            bindings = <&astrk_hash>;
            require-prior-idle-ms = <150>;
            layers = <0 1>;
        };
        combo_bsl {
            timeout-ms = <50>;
            key-positions = <RM3 RM4>;
            bindings = <&bsl>;
            require-prior-idle-ms = <150>;
            layers = <0 1>;
        };
        combo_l_bkt {
            timeout-ms = <50>;
            key-positions = <RM1 RM2>;
            bindings = <&lbkt_par>;
            require-prior-idle-ms = <150>;
            layers = <0 1>;
        };
        combo_r_bkt {
            timeout-ms = <50>;
            key-positions = <RM2 RM3>;
            bindings = <&rbkt_par>;
            require-prior-idle-ms = <150>;
            layers = <0 1>;
        };
        combo_l_brc {
            timeout-ms = <50>;
            key-positions = <RB1 RB2>;
            bindings = <&lbrc_lt>;
            require-prior-idle-ms = <150>;
            layers = <0 1>;
        };
        combo_r_brc {
            timeout-ms = <50>;
            key-positions = <RB2 RB3>;
            bindings = <&rbrc_gt>;
            require-prior-idle-ms = <150>;
            layers = <0 1>;
        };
        combo_caret {
            timeout-ms = <50>;
            key-positions = <RB0 RB1>;
            bindings = <&kp DE_CARET>;
            require-prior-idle-ms = <150>;
            layers = <0 1>;
        };
        combo_eql {
            timeout-ms = <50>;
            key-positions = <RT1 RT3>;
            bindings = <&kp DE_EQUAL>;
            require-prior-idle-ms = <150>;
            layers = <0 1>;
        };
        combo_amps {
            timeout-ms = <50>;
            key-positions = <RT0 RT1>;
            bindings = <&kp DE_AMPS>;
            require-prior-idle-ms = <150>;
            layers = <0 1>;
        };
        combo_dllr {
            timeout-ms = <50>;
            key-positions = <RB3 RB4>;
            bindings = <&kp DE_DLLR>;
            require-prior-idle-ms = <150>;
            layers = <0 1>;
        };
        combo_quote {
            timeout-ms = <50>;
            key-positions = <RM2 RB2>;
            bindings = <&quotes>;
            require-prior-idle-ms = <150>;
            layers = <0 1>;
        };
        combo_colon {
            timeout-ms = <50>;
            key-positions = <RM1 RM3>;
            bindings = <&kp DE_COLON>;
            require-prior-idle-ms = <150>;
            layers = <0 1>;
        };
        combo_prcnt {
            timeout-ms = <50>;
            key-positions = <RB1 RB3>;
            bindings = <&kp DE_PRCNT>;
            require-prior-idle-ms = <150>;
            layers = <0 1>;
        };
        combo_excl {
            timeout-ms = <50>;
            key-positions = <RT2 RM2>;
            bindings = <&kp DE_EXCL>;
            require-prior-idle-ms = <150>;
            layers = <0 1>;
        };
        combo_at {
            timeout-ms = <50>;
            key-positions = <RT3 RT4>;
            bindings = <&kp DE_AT>;
            require-prior-idle-ms = <150>;
            layers = <0 1>;
        };
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTZ";
            // Thumbs, from the outside in:
            //   left outer   - Tab, hold = MOUSE.
            //   left middle  - Esc, hold = NUMBER.
            //   Space/Return - hold = Shift; use the opposite thumb's Shift
            //                  for Shift+Tab and Delete.
            //   right middle - / (Shift: ?), hold = NUMBER. J+Plus is *
            //                  (Shift: #).
            //   right outer  - Backspace (Shift: Delete). The outer columns
            //                  are &none to train the 36/38-key layout.
            // Hyper sits on held A and +. Umlauts are firmware morphs on LALT
            // (D/K), so Hyper builds on RALT and triggers no morph.
            bindings = <
                &none         &kp DE_Q  &kp DE_W &kp DE_E        &kp DE_R       &kp DE_T       &kp C_PP     &kp EMOJI    &kp DE_Z   &u_umlaut           &kp DE_I       &o_umlaut       &kp DE_P     &none
                &none         &hy_a HYPER 0 &hm_s &hml LALT DE_D &hml LGUI DE_F &kp DE_G       &kp C_VOL_DN &kp C_VOL_UP &kp DE_H   &hmr RGUI DE_J      &hmr LALT DE_K &hmr RCTRL DE_L &hy_plus HYPER 0 &none
                &none         &kp DE_Y  &kp DE_X &kp DE_C        &kp DE_V       &kp DE_B                                 &kp DE_N   &kp DE_M            &kp DE_COMMA   &kp DE_DOT      &kp DE_MINUS &none
                                                &lt 2 TAB        &lt 1 ESC      &hmt LSHIFT SPACE                        &mt_sq RSHIFT 0 &lt_ent 1 RET &mt_bspc RALT 0
            >;
        };

        lower_layer {
            display-name = "NUMBER";
            bindings = <
                &trans &trans          &kp DE_N7        &kp DE_N8        &kp DE_N9        &trans &kp PASSWORD &rgb_ug RGB_TOG &trans   &trans         &trans         &trans           &trans   &trans
                &trans &kp DE_N0       &hml LCTRL DE_N4 &hml LALT DE_N5  &hml LGUI DE_N6  &trans &kp C_PREV   &kp C_NEXT      &kp LEFT &hmr RGUI DOWN &hmr LALT UP   &hmr RCTRL RIGHT &kp RALT &trans
                &trans &trans          &kp DE_N1        &kp DE_N2        &kp DE_N3        &trans                              &trans   &trans         &trans         &trans           &trans   &trans
                                                        &trans           &trans           &trans                              &trans   &bspcdel       &trans
            >;
        };

        raise_layer {
            display-name = "MOUSE";
            bindings = <
                &trans       &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &trans    &trans  &studio_unlock &trans   &msc SCRL_RIGHT &msc SCRL_UP   &msc SCRL_DOWN &msc SCRL_LEFT &trans &trans
                &trans       &trans       &trans       &trans &mkp LCLK &trans  &trans         &trans   &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_UP   &mmv MOVE_RIGHT &trans &trans
                &trans       &trans       &trans       &trans &mkp RCLK &trans                          &trans         &trans         &trans         &trans          &trans &trans 
                                                       &trans &trans    &trans                          &mkp LCLK      &mkp RCLK      &trans
            >;
        };
    };
};
