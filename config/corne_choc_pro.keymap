#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include "macros.h"
#include "keys_de.h"
#include "key-labels.h"

#define KEYS_L LT0 LT1 LT2 LT3 LT4 LM0 LM1 LM2 LM3 LM4 LB0 LB1 LB2 LB3 LB4
#define KEYS_R RT0 RT1 RT2 RT3 RT4 RM0 RM1 RM2 RM3 RM4 RM5 RB0 RB1 RB2 RB3 RB4 RB5

#define THUMBS LH2 LH1 LH0 RH0 RH1 RH2

/ {
    chosen {
        zmk,physical-layout = &default_layout;
    };
};


/ {
    beaviors {
        hml: HomeRowModLeft {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = < KEYS_R THUMBS >; // List of keys on the right side of the keyboard
            hold-trigger-on-release;
        };
        hmr: HomeRowModRight {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = < KEYS_L THUMBS >; // List of keys on the left side of the keyboard
            hold-trigger-on-release;
        };
    };
};

/ {
  beaviors {
    sq: SlashQuestion {
      compatible = "zmk,behavior-mod-morph";
      #binding-cells = <0>;
      bindings = <&kp DE_SLASH>, <&kp DE_QMARK>;
      mods = <(MOD_LSFT|MOD_RSFT)>;
    };
    bsl: BackslashPipe {
      compatible = "zmk,behavior-mod-morph";
      #binding-cells = <0>;
      bindings = <&kp DE_BSLH>, <&kp DE_PIPE>;
      mods = <(MOD_LSFT|MOD_RSFT)>;
    };
    quotes: SingleAndDouble {
      compatible = "zmk,behavior-mod-morph";
      #binding-cells = <0>;
      bindings = <&kp DE_APOS>, <&kp DE_DOUBLE_QUOTES>;
      mods = <(MOD_LSFT|MOD_RSFT)>;
    };
  };
};

/ {
    combos {
        compatible = "zmk,combos";
        combo_l_bkt {
            timeout-ms = <50>;
            key-positions = <RM1 RM2>;
            bindings = <&kp DE_LBKT>;
        };
        combo_r_bkt {
            timeout-ms = <50>;
            key-positions = <RM2 RM3>;
            bindings = <&kp DE_RBKT>;
        };
        combo_l_par {
            timeout-ms = <50>;
            key-positions = <RT1 RT2>;
            bindings = <&kp DE_LPAR>;
        };
        combo_r_par {
            timeout-ms = <50>;
            key-positions = <RT2 RT3>;
            bindings = <&kp DE_RPAR>;
        };
        combo_l_brc {
            timeout-ms = <50>;
            key-positions = <RB1 RB2>;
            bindings = <&kp DE_LBRC>;
        };
        combo_r_brc {
            timeout-ms = <50>;
            key-positions = <RB2 RB3>;
            bindings = <&kp DE_RBRC>;
        };
        combo_r_eql {
            timeout-ms = <50>;
            key-positions = <RT1 RT3>;
            bindings = <&kp DE_EQUAL>;
        };
        combo_r_colon {
            timeout-ms = <50>;
            key-positions = <RM1 RM3>;
            bindings = <&kp DE_COLON>;
        };
        combo_r_astrk {
            timeout-ms = <50>;
            key-positions = <RB1 RB3>;
            bindings = <&kp DE_ASTRK>;
        };
        combo_r_amps {
            timeout-ms = <50>;
            key-positions = <RT0 RT1>;
            bindings = <&kp DE_AMPS>;
        };
        combo_r_dllr {
            timeout-ms = <50>;
            key-positions = <RB0 RB1>;
            bindings = <&kp DE_DLLR>;
        };
        combo_r_quote {
            timeout-ms = <50>;
            key-positions = <RM4 RM5>;
            bindings = <&quotes>;
        };
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTZ";
            bindings = <
                &kp TAB       &kp DE_Q       &kp DE_W        &kp DE_E        &kp DE_R       &kp DE_T     &kp C_MUTE   &rgb_ug RGB_TOG &kp DE_Z &kp DE_U       &kp DE_I        &kp DE_O        &kp DE_P           &kp BSPC
                &mt HYPER ESC &hml LALT DE_A &hml LCTRL DE_S &hml LSHFT DE_D &hml LGUI DE_F &kp DE_G     &kp C_BRI_DN &kp C_BRI_UP    &kp DE_H &hmr RGUI DE_J &hmr RSHFT DE_K &hmr RCTRL DE_L &hmr RALT DE_TILDE &bsl
                &kp LSHFT     &kp DE_Y       &kp DE_X        &kp DE_C        &kp DE_V       &kp DE_B                                  &kp DE_N &kp DE_M       &kp DE_COMMA    &kp DE_DOT      &kp DE_MINUS       &sq
                                                             &kp LGUI        &lt 1 SYMBOL   &kp SPACE                                 &kp RET  &lt 2 DE_HASH  &kp RALT
            >;
        };

        lower_layer {
            display-name = "NUMBER";
            bindings = <
                &trans &trans    &kp DE_N7 &kp DE_N8 &kp DE_N9 &trans &trans   &trans &trans   &trans   &trans   &trans    &trans   &trans
                &trans &kp DE_N0 &kp DE_N4 &kp DE_N5 &kp DE_N6 &trans &trans   &trans &kp LEFT &kp DOWN &kp UP   &kp RIGHT &trans   &trans
                &trans &trans    &kp DE_N1 &kp DE_N2 &kp DE_N3 &trans                 &trans   &trans   &trans   &trans    &trans   &trans
                                           &trans    &trans    &trans                 &trans   &trans   &trans
            >;
        };

        raise_layer {
            display-name = "SYMBOL";
            bindings = <
                &trans &trans &trans &trans &trans &trans &studio_unlock &trans   &kp DE_AMPS &kp DE_LBKT &kp DE_EQUAL &kp DE_RBKT &kp DE_BSLH  &kp DE_GRAVE
                &trans &trans &trans &trans &trans &trans &bt BT_SEL 0   &trans   &kp DE_LT   &kp DE_LPAR &kp DE_AT    &kp DE_RPAR &kp DE_GT    &quotes
                &trans &trans &trans &trans &trans &trans                         &kp DE_DLLR &kp DE_LBRC &kp DE_ASTRK &kp DE_RBRC &kp DE_CARET &kp DE_PLUS
                                     &trans &trans &trans                         &trans      &trans      &trans
            >;
        };
    };
};

